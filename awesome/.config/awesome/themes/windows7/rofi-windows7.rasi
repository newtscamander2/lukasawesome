/*
 * Windows 7 Start menu, as far as rofi will go.
 *
 * The two things that make it read as Win7 rather than "a dark launcher":
 *   1. LIGHT panel with dark text. Win7's Start menu is a white app list, not
 *      a dark overlay — this is the biggest single difference from the win11
 *      and dr460nized rasi files.
 *   2. The search box is at the BOTTOM ("Search programs and files"), which is
 *      only possible because `children:` lets us reorder the window's parts.
 *
 * Anchored bottom-left, above the taskbar, so it grows out of the orb.
 */

* {
    w7-glass:      rgba(244, 250, 254, 96%);
    w7-panel:      rgba(255, 255, 255, 92%);
    w7-edge:       rgba(122, 168, 200, 90%);
    w7-text:       #12354f;
    w7-text-dim:   #4a708c;
    w7-sel:        rgba(203, 232, 250, 95%);
    w7-sel-edge:   rgba(90, 160, 205, 95%);
    w7-header:     rgba(28, 74, 112, 92%);

    background-color: transparent;
    text-color:       @w7-text;
    font:             "Noto Sans 10";
}

window {
    /* Bottom-left, clear of the 40px taskbar. */
    location:         southwest;
    anchor:           southwest;
    x-offset:         6px;
    y-offset:         -46px;
    width:            420px;
    height:           540px;
    background-color: @w7-glass;
    border:           1px;
    border-color:     @w7-edge;
    border-radius:    6px;
    padding:          0px;
    children:         [ mainbox ];
}

mainbox {
    background-color: transparent;
    padding:          0px;
    spacing:          0px;
    /* listview first, inputbar last: the Win7 search box sits at the bottom. */
    children:         [ listview, inputbar ];
}

listview {
    background-color: @w7-panel;
    columns:          1;
    lines:            11;
    spacing:          1px;
    padding:          6px 4px 6px 4px;
    margin:           4px 4px 0px 4px;
    border:           1px;
    border-color:     rgba(160, 195, 220, 70%);
    border-radius:    4px;
    scrollbar:        true;
    fixed-height:     true;
}

scrollbar {
    handle-color:     rgba(120, 170, 205, 80%);
    handle-width:     6px;
    background-color: rgba(0, 0, 0, 4%);
    border-radius:    3px;
}

element {
    padding:       5px 8px;
    spacing:       10px;
    border-radius: 3px;
    background-color: transparent;
    text-color:       @w7-text;
}

element selected {
    /* Aero's selection: pale blue fill with a defined edge, not a flat block. */
    background-color: @w7-sel;
    border:           1px;
    border-color:     @w7-sel-edge;
    text-color:       @w7-text;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

inputbar {
    background-color: transparent;
    padding:          6px 8px 8px 8px;
    spacing:          6px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @w7-text-dim;
    padding:          4px 2px;
}

entry {
    background-color: rgba(255, 255, 255, 95%);
    text-color:       @w7-text;
    placeholder:      "Search programs and files";
    placeholder-color: @w7-text-dim;
    padding:          6px 8px;
    border:           1px;
    border-color:     rgba(140, 180, 210, 85%);
    border-radius:    3px;
}

message {
    background-color: @w7-header;
    text-color:       #ffffff;
    padding:          6px 8px;
    border-radius:    3px;
}
