/*
 * Dr460nized (Garuda-inspired Dracula neon) rofi theme
 *
 * One file serves two launchers:
 *   drun grid  — 720x620, 6 columns x 5 rows of app tiles (Super+R)
 *   power menu — the same file with -theme-str overriding
 *                  window { width: 420px; height: 340px; }
 *                  listview { columns: 1; lines: 6; }
 *                  element-icon { size: 0px; }
 *                  element-text { horizontal-align: 0; }
 *
 * Because the power menu only overrides those four things, every other metric
 * below has to work at BOTH sizes. The row height is therefore split into a
 * small fixed chassis (border + padding + label) and the icon, which is the
 * only part that changes:
 *
 *     row = 4 (border) + 6 (padding) + 6 (gap) + ~15 (label) + icon
 *
 *   drun   icon 64px -> row ~96px; 5 rows + 4*6 spacing = 504 of 508 available
 *   power  icon  0px -> row ~32px; 6 rows + 5*6 spacing = 222 of 228 available
 *
 * Keep that arithmetic intact when editing: growing element padding, element
 * spacing or the label font shrinks BOTH grids, and the power menu is the one
 * that runs out of room first (it silently drops entries off the bottom).
 *
 * Translucency: the window is a depth-32 ARGB window with no _NET_WM_WINDOW_TYPE
 * and no _GTK_FRAME_EXTENTS, so picom's blur-background-exclude rules (dock /
 * GTK frames) do not match it -- dual_kawase blur and the hot-pink shadow glow
 * from picom.conf both apply. @bg is kept at 82% so that blur is actually
 * visible instead of being buried under an almost-opaque fill.
 */

configuration {
    show-icons:          true;
    display-drun:        "";
    drun-display-format: "{name}";

    /* Follow the mouse: highlight on hover, single click to launch. */
    hover-select:        true;
    me-select-entry:     "MouseDPrimary";
    me-accept-entry:     "MousePrimary";
}

* {
    /* Dr460nized palette (Dracula neon on near-black) */
    bg:           rgba(27, 27, 40, 82%);
    bg-alt:       rgba(40, 42, 54, 72%);
    bg-selected:  rgba(255, 121, 198, 16%);
    fg:           #f8f8f2;
    fg-soft:      #c6c8dd;
    fg-dim:       #6272a4;
    accent:       #ff79c6;
    accent-alt:   #bd93f9;
    border:       rgba(98, 114, 164, 55%);
    handle:       rgba(189, 147, 249, 55%);

    background-color: transparent;
    text-color:       @fg;
    font:             "FiraCode Nerd Font 11";
}

window {
    width:            720px;
    height:           620px;
    location:         center;
    anchor:           center;
    padding:          0;
    border:           2px;
    border-color:     @accent;
    border-radius:    12px;
    background-color: @bg;
    children:         [ mainbox ];
}

mainbox {
    padding:  22px;
    spacing:  16px;
    children: [ inputbar, listview ];
}

/* ---------------------------------------------------------------- search */

inputbar {
    padding:          12px 16px;
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border;
    border-radius:    10px;
    spacing:          12px;
    children:         [ textbox-prompt-icon, entry, num-filtered-rows, textbox-num-sep, num-rows ];
}

/* NOTE: a custom textbox only exists if its name starts with "textbox".
   The previous "prompt-icon" widget was silently dropped by rofi. */
textbox-prompt-icon {
    expand:           false;
    str:              "";
    font:             "FiraCode Nerd Font 13";
    padding:          0px 5px 0px 2px;
    text-color:       @accent;
    vertical-align:   0.5;
    background-color: transparent;
}

entry {
    font:              "FiraCode Nerd Font 12";
    placeholder:       "Type to search…";
    placeholder-color: @fg-dim;
    text-color:        @fg;
    vertical-align:    0.5;
    cursor:            text;
    background-color:  transparent;
}

/* "12 / 84" match counter, right-aligned in the search bar. */
num-filtered-rows {
    expand:           false;
    font:             "FiraCode Nerd Font 9";
    text-color:       @accent-alt;
    vertical-align:   0.5;
    background-color: transparent;
}

textbox-num-sep {
    expand:           false;
    str:              "/";
    font:             "FiraCode Nerd Font 9";
    text-color:       @fg-dim;
    vertical-align:   0.5;
    background-color: transparent;
}

num-rows {
    expand:           false;
    font:             "FiraCode Nerd Font 9";
    text-color:       @fg-dim;
    vertical-align:   0.5;
    background-color: transparent;
}

message {
    enabled: false;
}

/* Only seen when rofi has something to complain about, but an unstyled error
   box would render in rofi's default blue-on-white. */
error-message {
    padding:          20px;
    border:           2px;
    border-color:     @accent;
    border-radius:    10px;
    background-color: @bg-alt;
    text-color:       @fg;
}

/* ------------------------------------------------------------------ grid */

listview {
    columns:      6;
    lines:        5;
    spacing:      6px;
    padding:      0;
    fixed-height: true;
    layout:       vertical;
    cycle:        true;
    scrollbar:    true;
}

scrollbar {
    handle-width:     3px;
    handle-color:     @handle;
    background-color: transparent;
    border-radius:    4px;
}

/* The 2px border is always present and merely changes colour when selected,
   so the icon and label never shift by a pixel as you move through the grid. */
element {
    padding:          3px 8px;
    spacing:          6px;
    border:           2px;
    border-color:     transparent;
    border-radius:    12px;
    orientation:      vertical;
    children:         [ element-icon, element-text ];
    background-color: transparent;
    text-color:       @fg-soft;
    cursor:           pointer;
}

element selected {
    background-color: @bg-selected;
    border-color:     @accent;
    text-color:       @fg;
}

/* dmenu -a / -u mark entries active/urgent; without these they would fall back
   to rofi's built-in blue/red and break the palette. */
element normal.active,
element alternate.active {
    text-color: @accent-alt;
}

element normal.urgent,
element alternate.urgent {
    text-color: @accent;
}

element selected.active,
element selected.urgent {
    background-color: @bg-selected;
    border-color:     @accent;
    text-color:       @fg;
}

element-icon {
    size:             64px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    font:             "FiraCode Nerd Font 9";
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
    background-color: transparent;
}
