        "t_note": "Noget underviseren understregede.",
        "t_caption": "Tavle: skitse", "t_problem": "Opgave",
        "t_restate": "Gengiv opgaveteksten her.",
        "t_answer": "Skriv svaret her.",
        "s_intro": "Introduktion", "s_method": "Metode", "s_results": "Resultater",
        "s_discussion": "Diskussion", "s_conclusion": "Konklusion",
        "t_abstract": "Kort resume af hvad rapporten gor, og hvad den konkluderer.",
        "t_intro": "Beskriv problemet, hvorfor det er vigtigt, og rapportens opbygning.",
        "t_method": "Beskriv fremgangsmaden: data, algoritmer, forsogsopstilling.",
        "t_results": "Fremlaeg det, du malte eller beviste.",
        "t_discussion": "Fortolk resultaterne, og vaer aerlig om begraensningerne.",
        "t_conclusion": "Svar paa sporgsmalet fra introduktionen.",
        "t_table": "Koretider i millisekunder.", "t_input": "Input",
    },
    "english": {
        "s_overview": "Overview", "s_notes": "Notes", "s_exercises": "Exercises",
        "t_note": "Something the lecturer stressed.",
        "t_caption": "Whiteboard: sketch", "t_problem": "Problem",
        "t_restate": "Restate the problem here.",
        "t_answer": "Write the answer here.",
        "s_intro": "Introduction", "s_method": "Method", "s_results": "Results",
        "s_discussion": "Discussion", "s_conclusion": "Conclusion",
        "t_abstract": "One paragraph on what the report does and what it concludes.",
        "t_intro": "State the problem, why it matters, and how the report is structured.",
        "t_method": "Describe the approach: data, algorithms, experimental setup.",
        "t_results": "Present what you measured or proved.",
        "t_discussion": "Interpret the results, and state the limitations honestly.",
        "t_conclusion": "Answer the question posed in the introduction.",
        "t_table": "Running times in milliseconds.", "t_input": "Input",
    },
}

AUX_DIR = "latex_debug_files"

LATEXMKRC = f"""\
# Build config for this document (latexmk picks it up automatically).
$pdf_mode = 1;      # pdflatex
$bibtex_use = 2;    # run biber when the document cites anything

# Keep .aux/.log/.bbl/.bcf/.fls and friends out of the way: only main.tex and
# main.pdf stay here. $aux_dir alone (not $out_dir) means the PDF is still
# written next to the source, so the viewer finds it where it expects.
# VimTeX reads this file and follows aux_dir, so its quickfix list still finds
# the log.
$aux_dir = '{AUX_DIR}';

# -shell-escape so a goat document using code=minted compiles as-is.
set_tex_cmds('-shell-escape -synctex=1 -interaction=nonstopmode -file-line-error %O %S');
"""

TEMPLATES = {"lecture": LECTURE_TEMPLATE, "homework": HOMEWORK_TEMPLATE,
             "report": REPORT_TEMPLATE}
# Which template each --create-* action uses unless --template says otherwise.
DEFAULT_TEMPLATE = {"lecture": "lecture", "homework": "homework",
                    "report": "report"}

# One line each, for --templates and for --help in a course.
TEMPLATE_SUMMARY = {
    "lecture": "running notes: header, sections, commented gcode/gnote/gimage",
    "homework": "hand-in: front page, numbered question boxes to answer",
    "report": "report: front page, abstract, contents, intro..conclusion, bibliography",
}


def load_template(name):
    """Template text for `name`."""
    if name not in TEMPLATES:
        raise Fail(f"no template '{name}'. Available: "
                   f"{', '.join(sorted(TEMPLATES))} ({INVOKED} --templates)")
    return TEMPLATES[name]


def cmd_templates(args):
    """List what --template accepts."""
    if args.quiet:
        for name in sorted(TEMPLATES):
            print(name)
        return 0
    log("templates for --template")
    for line in template_lines():
        print(f"   {line}")
    print()
    log(f'in a course: {INVOKED} --create-lecture "Title" --template report')
    return 0


def template_lines():
    """['lecture    running notes: ...', ...] shared by --templates and --help."""
    width = max(len(n) for n in TEMPLATES)
    kinds = {v: k for k, v in DEFAULT_TEMPLATE.items()}
    out = []
    for name in sorted(TEMPLATES):
        default_for = kinds.get(name)
        note = f"  (--create-{default_for})" if default_for else ""
        out.append(f"{name.ljust(width)}  {TEMPLATE_SUMMARY.get(name, '')}{note}")
    return out


def render_template(text, fields):
    """Fill a template's {placeholders}."""
    return text.format(**fields)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
ANY_LEVEL = ("root", "semester", "course", "entry", "outside")

# Everything still parses at every level -- being at the wrong one is an error
# that explains itself, not an unknown flag. This only decides what --help
# offers you here, so the help stays as short as the level is. "document" is not
# a level: it means the current directory holds a .tex document.
VISIBLE_AT = {
    "create_semester": ("root", "outside"),
    "create_course": ("semester",),
    "create_lecture": ("course",),
    "create_homework": ("course",),
    "create_report": ("course",),
    "templates": ("course",),
    "template": ("course",),
    "slug": ("semester", "course"),
    "get_version": ("document",),
    "check_upgrade": ("document",),
    "upgrade": ("document",),
}


def has_document(directory):
    """True when this directory holds a .tex document you could act on."""
    if any((directory / n).is_file() for n in MAIN_CANDIDATES):
        return True
    try:
        return any("\\documentclass" in p.read_text(encoding="utf-8", errors="replace")
                   for p in sorted(directory.glob("*.tex")))
    except OSError:
        return False


def epilog_for(loc, in_document):
    """The part of --help that depends on where you are."""
    document_block = ""
    if in_document:
        document_block = (
            "the document here:\n"
            "  gm main.tex --get-version     which goat release it targets\n"
            "  gm main.tex --check-upgrade   is a newer goat available?\n"
            "  gm main.tex --upgrade         re-pin, then check it still compiles\n")

    if loc.level == "outside":
        here = ("here: not inside a coursework tree\n\n"
                "  gm --create-semester 1        make this directory a root\n\n"
                "the tree is <root>/<N>semester/<course>/<date>-<slug>/main.tex,\n"
                "and you move between the levels with cd\n")
    elif loc.level == "root":
        nxt = max((int(n.removesuffix("semester"))
                   for n in semesters_in(loc.cwd)), default=0) + 1
        here = (f"here: the root of the tree\n\n"
                f"  gm --create-semester {nxt}\n\n"
                f"then: cd {nxt}semester && gm --create-course math\n")
    elif loc.level == "semester":
        here = (f"here: {loc.semester}\n\n"
                f"  gm --create-course math\n\n"
                f"then: cd math && gm --create-lecture \"...\"\n")
    elif loc.level == "course":
        here = (f"here: the course {loc.course}. Each of these makes a dated\n"
                f"directory with a main.tex from the named template:\n\n"
                f"  gm --create-lecture \"Writing hello world in Python\"\n"
                f"  gm --create-homework \"Uge 3\"\n"
                f"  gm --create-report \"Sorteringsbenchmark\"\n\n"
                f"templates, for --template:\n"
                + "".join(f"  {line}\n" for line in template_lines()))
    else:  # entry
        here = (f"here: {loc.entry}. This is where you write, so there is\n"
                f"nothing to create:\n\n"
                f"  latexmk -pdf main.tex\n"
                f"  cd ..                         back to {loc.course}\n")
    return here + ("\n" + document_block if document_block else "")


def build_parser(loc, in_document=False):
    levels = (loc.level, "document") if in_document else (loc.level,)

    def shown(name, text):
        """Help text, or hidden when this level cannot use the option."""
        allowed = VISIBLE_AT.get(name, ANY_LEVEL)
        return text if any(l in allowed for l in levels) else argparse.SUPPRESS

    p = argparse.ArgumentParser(
        prog=INVOKED,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Manage goat LaTeX documents and the coursework tree.",
        epilog=epilog_for(loc, in_document))
    p.add_argument("file", nargs="?", metavar="FILE",
                   help="a .tex file, or a directory containing one "
                        "(default: the document in the current directory)")

    actions = p.add_argument_group("actions (pick one)")
    g = actions.add_mutually_exclusive_group()
    g.add_argument("--get-version", action="store_true",
                   help=shown("get_version",
                              "print the goat version FILE was written against"))
    g.add_argument("--check-upgrade", action="store_true",
                   help=shown("check_upgrade",
                              "report whether FILE can move to a newer goat"))
    g.add_argument("--upgrade", nargs="?", const=True, metavar="VERSION",
                   help=shown("upgrade",
                              "record VERSION (default: the newest goat) in FILE, "
                              "then verify it still compiles"))
    g.add_argument("--create-semester", nargs="?", const="", metavar="N",
                   help=shown("create_semester",
                              "create <N>semester here (default: the next one)"))
    g.add_argument("--create-course", nargs="?", const="", metavar="NAME",
                   help=shown("create_course", "create a course directory here"))
    g.add_argument("--create-lecture", nargs="?", const="", metavar="TITLE",
                   help=shown("create_lecture", "new entry from the lecture template"))
    g.add_argument("--create-homework", nargs="?", const="", metavar="TITLE",
                   help=shown("create_homework", "new entry from the homework template"))
    g.add_argument("--create-report", nargs="?", const="", metavar="TITLE",
                   help=shown("create_report", "new entry from the report template"))
    g.add_argument("--templates", action="store_true",
                   help=shown("templates", "list the templates --template accepts"))

    beh = p.add_argument_group("behaviour")
    beh.add_argument("--template", metavar="NAME",
                     help=shown("template", "which goat template becomes main.tex"))
    beh.add_argument("--slug", metavar="SLUG",
                     help=shown("slug", "directory name (default: from the title)"))
    beh.add_argument("-n", "--dry-run", action="store_true",
                     help="print what would happen, change nothing")
    beh.add_argument("-q", "--quiet", action="store_true",
                     help="print bare values, for scripts")
    beh.add_argument("--json", action="store_true",
                     help="machine-readable output where it applies")
    beh.add_argument("--version", action="version",
                     version=f"{PROG} {TOOL_VERSION}")
    return p


def main(argv):
    # Where we are decides what --help offers, so locate first. (Cheap: it only
    # looks at the path, and lists the root's directories.)
    loc = locate()
    parser = build_parser(loc, in_document=has_document(loc.cwd))
    args = parser.parse_args(argv[1:])

    # An entry action takes a title, which may also be sitting in `file` when
    # it was written as: gm --create-lecture "Some title"
    entries = [("lecture", args.create_lecture),
               ("homework", args.create_homework),
               ("report", args.create_report)]
    entries = [(kind, title) for kind, title in entries if title is not None]

    try:
        if args.create_semester is not None:
            if not args.create_semester and args.file:
                args.create_semester, args.file = args.file, None
            return cmd_create_semester(args, loc)
        if args.create_course is not None:
            if not args.create_course and args.file:
                args.create_course, args.file = args.file, None
            return cmd_create_course(args, loc)
        if entries:
            kind, title = entries[0]
            if not title and args.file:
                title, args.file = args.file, None
            return cmd_create_entry(kind, title, args, loc)
        if args.get_version:
            return cmd_get_version(args)
        if args.check_upgrade:
            return cmd_check_upgrade(args)
        if args.upgrade is not None:
            return cmd_upgrade(args)
        if args.templates:
            return cmd_templates(args)

        # No action given: `gm file.tex` is most usefully the version query, and
        # a bare `gm` is "where am I, and what is here".
        if args.file:
            return cmd_get_version(args)
        return cmd_status(args, loc)
    except Fail as exc:
        err(str(exc))
        return 1
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv))
