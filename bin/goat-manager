#!/usr/bin/env python3
"""goat-manager (gm) -- manage goat LaTeX documents and the coursework tree.

The tree is three levels, and it is the only state this tool has:

    <root>/                 anything you like: ~/aarhusuni, ~/uni, ...
      <N>semester/          1semester, 2semester, ...
        <course>/           math, beregnelighed-og-logik, ...
          <YYYY-MM-DD>-<slug>/main.tex

There is no configuration file. gm works out where it is by looking at the
directory you run it in, and what you can create depends on that level -- one
level down at a time, the same way you would do it by hand:

    in the root        gm --create-semester 1
    in a semester      gm --create-course math
    in a course        gm --create-lecture "Writing hello world in Python"
                       gm --create-homework "Uge 3"
                       gm --create-report "Sorteringsbenchmark"
    in an entry        nothing: this is where you write

Each --create-* in a course makes the dated directory and writes a main.tex from
one of three templates -- lecture, homework, report (gm --templates, --template
picks one) -- plus an img/ directory and a .latexmkrc that keeps .aux/.log/.bbl
and the rest in a latex_debug_files/ subdirectory. Nothing is ever overwritten:
if the document is already there, gm refuses.

A course may hold a .gm file (JSON: professor, brightspace link, anything else)
which gm shows when you run it there. You write that file by hand; gm only reads.

You move between levels with cd. Typed on its own, gm says where you are and
what is there; gm --help offers only what this level can actually do.

It also tracks which goat release a document targets, so a document written
today still compiles years from now:

    gm main.tex --get-version
    gm main.tex --check-upgrade
    gm main.tex --upgrade        # re-pin, then verify it still compiles

Optional environment variables, for filling in scaffolded documents:

    GOAT_AUTHOR      name for \\setgoatauthor
    GOAT_STUDENT_ID  \\setgoatstudentid
    GOAT_DEPARTMENT  \\setgoatdept
    GOAT_LANG        english (default) | danish
    GOAT_STYLE       au (default) | plain

Exit codes: 0 success / nothing to do, 1 error, 10 an upgrade is available,
11 the document needs a newer goat than the one installed.

Stdlib only: needs Python 3.11+, and TeX Live only for the verification compile.
"""

import argparse
import datetime as dt
import difflib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
import unicodedata
from dataclasses import dataclass, field
from pathlib import Path

TOOL_VERSION = "2.1.0"
PROG = "goat-manager"                       # canonical name, for --version
INVOKED = Path(sys.argv[0]).name or PROG    # what you typed, for hints

# ---------------------------------------------------------------------------
# Output helpers. Same glyph vocabulary as the dotfiles installer (lib.sh) so
# the two tools read alike in a terminal.
# ---------------------------------------------------------------------------
if sys.stdout.isatty():
    C_BLUE, C_GREEN, C_YELLOW, C_RED, C_DIM, C_RESET = (
        "\033[1;34m", "\033[1;32m", "\033[1;33m", "\033[1;31m", "\033[2m", "\033[0m")
else:
    C_BLUE = C_GREEN = C_YELLOW = C_RED = C_DIM = C_RESET = ""


def log(msg):
    print(f"{C_BLUE}::{C_RESET} {msg}")


def ok(msg):
    print(f"{C_GREEN} ok{C_RESET} {msg}")


def warn(msg):
    sys.stdout.flush()   # keep stderr interleaved in order when piped
    print(f"{C_YELLOW}  ! {C_RESET}{msg}", file=sys.stderr)


def err(msg):
    sys.stdout.flush()
    print(f"{C_RED}  x {C_RESET}{msg}", file=sys.stderr)


def dim(text):
    return f"{C_DIM}{text}{C_RESET}"


class Fail(Exception):
    """A user-facing error: reported via err() and turned into exit code 1."""


# ---------------------------------------------------------------------------
# Settings. Not a config file: just optional environment variables, so nothing
# has to be installed or kept in sync for gm to work.
# ---------------------------------------------------------------------------
GOAT_REPO_FALLBACK = "~/projects/goat"   # only used if kpsewhich cannot help


def setting(name, default=""):
    return os.environ.get(f"GOAT_{name}", default).strip()


# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
def vkey(text):
    """'v0.1' -> (0, 1, 0). None when text is not a recognisable version.

    Padded to three components so a two-component release ("0.1", as written by
    goat today) compares correctly against a three-component one ("0.1.4").
    """
    if not text:
        return None
    m = re.match(r"^v?(\d+(?:\.\d+){0,3})", text.strip())
    if not m:
        return None
    parts = [int(p) for p in m.group(1).split(".")]
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts[:4])


def vtext(text):
    """Normalised display form of a version string ('v0.1' -> '0.1')."""
    return text.strip().lstrip("vV") if text else text


@dataclass
class Pin:
    """How (and where) a document records the goat release it targets."""
    version: str | None          # None for a date pin we cannot map to a version
    kind: str                    # comment | rollback | date | projectfile
    where: str                   # "main.tex:1" or a project file path
    raw: str = ""                # the line/value as written

    def describe(self):
        kinds = {
            "comment": "magic comment",
            "rollback": "LaTeX rollback pin",
            "date": "LaTeX date pin",
            "projectfile": "project file",
        }
        return f"{kinds.get(self.kind, self.kind)}, {self.where}"


@dataclass
class GoatInstall:
    """The goat release installed on this machine."""
    version: str
    date: str
    path: Path


def kpsewhich(name):
    """Absolute path of a TeX file, or None. Same lookup goat's tools use."""
    if not shutil.which("kpsewhich"):
        return None
    try:
        out = subprocess.run(["kpsewhich", name], capture_output=True,
                             text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    first = out.stdout.strip().splitlines()
    if out.returncode != 0 or not first:
        return None
    p = Path(first[0])
    return p if p.is_file() else None


PROVIDES_RE = re.compile(
    r"\\ProvidesPackage\s*\{goat\}\s*\[\s*"
    r"(?P<date>\d{4}[/-]\d{2}[/-]\d{2})\s+v?(?P<ver>[0-9][\w.\-]*)")


def installed_goat():
    """Locate goat.sty and read its \\ProvidesPackage version and date."""
    candidates = []
    found = kpsewhich("goat.sty")
    if found:
        candidates.append(found)
    candidates += [
        Path.home() / "texmf/tex/latex/goat/goat.sty",
        Path(GOAT_REPO_FALLBACK).expanduser() / "goat" / "goat.sty",
    ]
    for path in candidates:
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        m = PROVIDES_RE.search(text)
        if m:
            return GoatInstall(vtext(m.group("ver")), m.group("date"), path)
        # goat.sty exists but has no parsable version line: still report it.
        return GoatInstall("unknown", "unknown", path)
    raise Fail("no goat installation found. Run goat's install.sh, then check "
               "`kpsewhich goat.sty`.")


def goat_repo(install=None):
    """The goat checkout, resolved through the texmf symlink when possible.

    install.sh symlinks <repo>/goat into ~/texmf/tex/latex/goat, so resolving
    the real path of goat.sty and walking up lands in the repo.
    """
    if install is not None:
        real = install.path.resolve()
        for parent in list(real.parents)[:4]:
            if (parent / "install.sh").is_file() and (parent / "goat").is_dir():
                return parent
    repo = Path(GOAT_REPO_FALLBACK).expanduser()
    return repo if repo.is_dir() else None


CHANGELOG_HEADING_RE = re.compile(
    r"^##\s*\[?v?(?P<ver>\d+(?:\.\d+){1,3})\]?\s*(?:[-–]\s*(?P<date>[\d/-]+))?")


def changelog_entries(repo):
    """[(version, date, [body lines])] newest first, from goat's CHANGELOG.md.

    Optional: goat has no CHANGELOG.md yet, in which case this returns [] and
    --check-upgrade simply omits the "what changed" section.
    """
    if repo is None:
        return []
    path = repo / "CHANGELOG.md"
    if not path.is_file():
        return []
    entries, current = [], None
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        m = CHANGELOG_HEADING_RE.match(line)
        if m:
            current = (vtext(m.group("ver")), m.group("date") or "", [])
            entries.append(current)
        elif current is not None and line.strip():
            current[2].append(line.rstrip())
    return entries


def latest_known(install, entries):
    """Newest version this machine knows about: installed vs. CHANGELOG top."""
    best, best_key = install.version, vkey(install.version) or (0, 0, 0)
    for version, _date, _body in entries:
        key = vkey(version)
        if key and key > best_key:
            best, best_key = version, key
    return best


# ---------------------------------------------------------------------------
# Reading a document's pin
# ---------------------------------------------------------------------------
# `% !goat version = 0.1.4`, `%!goat 0.1.4`, `% !goat-version: 0.1.4`
MAGIC_RE = re.compile(
    r"^\s*%+\s*!\s*goat(?:[ _-]*version)?\s*[:=]?\s*v?(?P<ver>\d[\w.\-]*)", re.I)
USEPKG_RE = re.compile(
    r"\\(?:usepackage|RequirePackage)\s*(?:\[(?P<opts>[^\]]*)\])?\s*"
    r"\{(?P<pkgs>[^}]*)\}(?:\s*\[(?P<pin>[^\]]*)\])?")
INPUT_RE = re.compile(r"\\(?:input|include)\s*\{(?P<path>[^}]+)\}")
DATE_PIN_RE = re.compile(r"^\d{4}[/-]\d{2}[/-]\d{2}$")

PROJECT_FILES = (".goat-version", "goat.toml")
MAIN_CANDIDATES = ("main.tex", "report.tex", "notes.tex", "homework.tex")


def strip_comment(line):
    """Drop a trailing LaTeX comment, respecting \\%. (Same rule as goat-lint.)"""
    out, esc = [], False
    for ch in line:
        if ch == "%" and not esc:
            break
        out.append(ch)
        esc = (ch == "\\") and not esc
    return "".join(out)


@dataclass
class DocScan:
    """What we learned from reading a .tex file (and its \\input children)."""
    path: Path
    uses_goat: bool = False
    usepackage_line: int | None = None
    pins: list = field(default_factory=list)

    def pin(self):
        """The effective pin, highest precedence first.

        A rollback pin wins because it is what LaTeX actually acts on; the magic
        comment is next because it is what this tool writes; a bare date pin and
        a project file are weaker records.
        """
        order = {"rollback": 0, "comment": 1, "date": 2, "projectfile": 3}
        return min(self.pins, key=lambda p: order.get(p.kind, 9), default=None)


def scan_document(path, follow=True):
    """Read a document, and one level of \\input children, for goat pins."""
    scan = DocScan(path=path)
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as exc:
        raise Fail(f"cannot read {path}: {exc}") from exc

    children = []
    for lineno, raw in enumerate(lines, 1):
        m = MAGIC_RE.match(raw)
        if m:
            scan.pins.append(Pin(vtext(m.group("ver")), "comment",
                                 f"{path.name}:{lineno}", raw.strip()))
        code = strip_comment(raw)
        for um in USEPKG_RE.finditer(code):
            pkgs = [p.strip() for p in um.group("pkgs").split(",")]
            if "goat" not in pkgs:
                continue
            scan.uses_goat = True
            if scan.usepackage_line is None:
                scan.usepackage_line = lineno
            arg = (um.group("pin") or "").strip()
            if arg.startswith("="):
                scan.pins.append(Pin(vtext(arg[1:]), "rollback",
                                     f"{path.name}:{lineno}", arg))
            elif DATE_PIN_RE.match(arg):
                scan.pins.append(Pin(None, "date",
                                     f"{path.name}:{lineno}", arg))
        for im in INPUT_RE.finditer(code):
            children.append(im.group("path").strip())

    # The pin may live in a preamble that main.tex \inputs.
    if follow and not scan.pins:
        for rel in children:
            child = (path.parent / rel)
            if child.suffix != ".tex":
                child = child.with_suffix(".tex")
            if child.is_file():
                sub = scan_document(child, follow=False)
                scan.uses_goat = scan.uses_goat or sub.uses_goat
                scan.pins.extend(sub.pins)

    if not scan.pins:
        found = project_pin(path.parent)
        if found:
            scan.pins.append(found)
    return scan


def project_pin(start):
    """Look for .goat-version / goat.toml in this directory or an ancestor."""
    home = Path.home()
    for directory in [start, *start.parents]:
        for name in PROJECT_FILES:
            path = directory / name
            if not path.is_file():
                continue
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            if name == ".goat-version":
                version = text.strip().splitlines()[0].strip() if text.strip() else ""
            else:
                try:
                    data = tomllib.loads(text)
                except tomllib.TOMLDecodeError:
                    continue
                version = data.get("version") or data.get("goat", {}).get("version", "")
            if vkey(version):
                return Pin(vtext(version), "projectfile", str(path), text.strip())
        if directory == home:
            break
    return None


def resolve_document(arg):
    """Turn a CLI argument (file, directory, or nothing) into a .tex path."""
    start = Path(arg).expanduser() if arg else Path.cwd()
    if start.is_file():
        return start
    if not start.exists() and not start.suffix:
        guess = start.with_suffix(".tex")
        if guess.is_file():
            return guess
    if not start.exists():
        raise Fail(f"{start}: no such file or directory")
    if not start.is_dir():
        raise Fail(f"{start}: not a file or directory")

    for name in MAIN_CANDIDATES:
        if (start / name).is_file():
            return start / name
    roots = []
    for p in sorted(start.glob("*.tex")):
        try:
            if "\\documentclass" in p.read_text(encoding="utf-8", errors="replace"):
                roots.append(p)
        except OSError:
            continue
    if len(roots) == 1:
        return roots[0]
    if not roots:
        raise Fail(f"{start}: no .tex document found here "
                   f"(looked for {', '.join(MAIN_CANDIDATES)} and any \\documentclass file)")
    names = ", ".join(p.name for p in roots)
    raise Fail(f"{start}: several documents found ({names}) — name one explicitly")


# ---------------------------------------------------------------------------
# Actions: versions
# ---------------------------------------------------------------------------
def cmd_get_version(args):
    path = resolve_document(args.file)
    scan = scan_document(path)
    install = installed_goat()
    pin = scan.pin()

    if args.json:
        print(json.dumps({
            "file": str(path),
            "uses_goat": scan.uses_goat,
            "version": pin.version if pin else None,
            "pinned": pin is not None,
            "pin_kind": pin.kind if pin else None,
            "pin_where": pin.where if pin else None,
            "installed": install.version,
            "installed_date": install.date,
        }, indent=2))
        return 0

    if not scan.uses_goat and pin is None:
        raise Fail(f"{path.name}: not a goat document "
                   f"(no \\usepackage{{goat}}, no version pin)")

    if pin is None:
        if args.quiet:
            print(install.version)
        else:
            print(f"{path.name}: goat {install.version} "
                  f"{dim('(not pinned — whatever goat is installed)')}")
            log(f"pin it with: {INVOKED} {path.name} --upgrade")
        return 0

    if pin.version is None:          # a date pin we could not map to a version
        if args.quiet:
            print(pin.raw)
        else:
            print(f"{path.name}: goat release dated {pin.raw} "
                  f"{dim('(' + pin.describe() + ')')}")
        return 0

    if args.quiet:
        print(pin.version)
    else:
        print(f"{path.name}: goat {pin.version} {dim('(' + pin.describe() + ')')}")
    return 0


def cmd_check_upgrade(args):
    path = resolve_document(args.file)
    scan = scan_document(path)
    install = installed_goat()
    repo = goat_repo(install)
    entries = changelog_entries(repo)
    latest = latest_known(install, entries)
    pin = scan.pin()

    if not scan.uses_goat and pin is None:
        raise Fail(f"{path.name}: not a goat document "
                   f"(no \\usepackage{{goat}}, no version pin)")

    have = pin.version if pin and pin.version else None
    have_key = vkey(have)
    latest_key = vkey(latest)
    if have_key is None:
        state = "unpinned"
    elif latest_key is None or have_key == latest_key:
        state = "current"
    elif have_key < latest_key:
        state = "upgradable"
    else:
        state = "ahead"

    if args.json:
        print(json.dumps({
            "file": str(path),
            "version": have,
            "pinned": pin is not None,
            "pin_kind": pin.kind if pin else None,
            "installed": install.version,
            "latest": latest,
            "state": state,
        }, indent=2))
    else:
        if pin and have:
            print(f"{path.name}: pinned to goat {have} {dim('(' + pin.describe() + ')')}")
        elif pin:
            print(f"{path.name}: pinned to the release dated {pin.raw} "
                  f"{dim('(' + pin.describe() + ')')}")
        else:
            print(f"{path.name}: {C_YELLOW}no goat version recorded{C_RESET}")
        print(f"installed:  goat {install.version} ({install.date}) {dim(install.path)}")
        if vkey(latest) and vkey(latest) != vkey(install.version):
            source = str(repo / "CHANGELOG.md") if repo else "CHANGELOG.md"
            print(f"latest:     goat {latest} {dim('(from ' + source + ')')}")
        print()

        if state == "current":
            ok(f"up to date — {path.name} already targets the latest goat ({latest})")
        elif state == "upgradable":
            print(f"is able to upgrade to the latest version of goat, "
                  f"which is version {latest}")
            _print_changes(entries, have, latest)
            log(f"apply with: {INVOKED} {path.name} --upgrade")
        elif state == "ahead":
            warn(f"{path.name} targets goat {have}, but only {latest} is available here")
            log("update the library first: cd ~/projects/goat && git pull && ./install.sh")
        else:
            print(f"nothing is recorded yet; the latest version of goat is {latest}")
            log(f"record it with: {INVOKED} {path.name} --upgrade")

    return {"current": 0, "upgradable": 10, "unpinned": 10, "ahead": 11}[state]


def _print_changes(entries, have, target):
    """Print CHANGELOG bodies strictly between the pinned and target versions."""
    have_key, target_key = vkey(have), vkey(target)
    shown = False
    for version, date, body in entries:
        key = vkey(version)
        if not key or key <= (have_key or (0, 0, 0)) or key > target_key:
            continue
        if not shown:
            print("\nchanges:")
            shown = True
        header = f"  {version}" + (f" ({date})" if date else "")
        print(header)
        for line in body[:12]:
            print(f"    {line}")


def cmd_upgrade(args):
    path = resolve_document(args.file)
    scan = scan_document(path, follow=False)
    install = installed_goat()
    entries = changelog_entries(goat_repo(install))

    target = (vtext(args.upgrade) if isinstance(args.upgrade, str)
              else latest_known(install, entries))
    if not vkey(target):
        raise Fail(f"'{target}' is not a version number")
    if not scan.uses_goat:
        raise Fail(f"{path.name}: not a goat document (no \\usepackage{{goat}} here)")

    pin = scan.pin()
    if pin and pin.version and vkey(pin.version) == vkey(target):
        ok(f"{path.name} already targets goat {target} — nothing to do")
        return 0
    if pin and pin.kind == "projectfile":
        warn(f"the current pin lives in {pin.where}; writing a document-level "
             f"pin into {path.name} which takes precedence")

    original = path.read_text(encoding="utf-8", errors="replace")
    updated, note = rewrite_pin(original, target, scan)
    if updated == original:
        ok(f"{path.name} already targets goat {target} — nothing to do")
        return 0

    if args.dry_run:
        log(f"would {note} in {path.name}")
        for line in _diff_preview(original, updated):
            print(f"   {line}")
        return 0

    # Always keep a backup while rewriting: it is what lets a failed
    # verification compile leave the document exactly as it was.
    backup = path.with_suffix(path.suffix + ".bak")
    shutil.copy2(path, backup)
    path.write_text(updated, encoding="utf-8")
    ok(f"pinned {path.name} to goat {target}")

    good, output = verify_compile(path)
    if good:
        ok("test compile passed")
        backup.unlink(missing_ok=True)
        return 0

    shutil.copy2(backup, path)
    backup.unlink(missing_ok=True)
    err(f"test compile FAILED — {path.name} restored unchanged")
    for line in output:
        print(f"   {line}", file=sys.stderr)
    return 1


def rewrite_pin(text, target, scan):
    """Return (new text, description) with the goat pin set to `target`.

    Updates a pin that is already there, in place; otherwise inserts a magic
    comment just above the \\usepackage{goat} line. Any LaTeX rollback pin is
    kept in sync, since that is the one LaTeX itself acts on.
    """
    lines = text.splitlines(keepends=True)
    changed, notes = False, []

    for i, raw in enumerate(lines):
        m = MAGIC_RE.match(raw)
        if m:
            lines[i] = raw[:m.start("ver")] + target + raw[m.end("ver"):]
            changed = True
            notes.append("update the magic comment")
            break

    for i, raw in enumerate(lines):
        code = strip_comment(raw)
        for um in USEPKG_RE.finditer(code):
            if "goat" not in [p.strip() for p in um.group("pkgs").split(",")]:
                continue
            arg = (um.group("pin") or "").strip()
            if arg.startswith("="):
                start, end = um.span("pin")
                lines[i] = raw[:start] + "=" + target + raw[end:]
                changed = True
                notes.append("update the rollback pin")

    if not changed:
        insert_at = (scan.usepackage_line - 1) if scan.usepackage_line else 0
        lines.insert(insert_at, f"% !goat version = {target}\n")
        notes.append("add a version pin")

    return "".join(lines), " and ".join(notes)


def _diff_preview(before, after, context=1):
    """Minimal line-level preview of what --upgrade would change."""
    out = []
    for line in difflib.unified_diff(before.splitlines(), after.splitlines(),
                                     lineterm="", n=context):
        if line.startswith(("---", "+++", "@@")):
            continue
        out.append(line)
    return out[:12]


def verify_compile(path):
    """Compile the document into a temp directory. Returns (ok, log tail)."""
    if not shutil.which("latexmk"):
        warn("latexmk not found — skipping the verification compile")
        return True, []
    with tempfile.TemporaryDirectory(prefix="gm-verify-") as tmp:
        # -auxdir as well as -outdir: the document's own .latexmkrc sets
        # $aux_dir, and without overriding it the check would write into the
        # real build directory instead of staying in the temp one.
        cmd = ["latexmk", "-pdf", "-interaction=nonstopmode", "-halt-on-error",
               "-shell-escape", f"-outdir={tmp}", f"-auxdir={tmp}", path.name]
        try:
            proc = subprocess.run(cmd, cwd=path.parent, capture_output=True,
                                  text=True, timeout=300)
        except subprocess.TimeoutExpired:
            return False, ["latexmk timed out after 300s"]
        except OSError as exc:
            return False, [f"could not run latexmk: {exc}"]
        if proc.returncode == 0:
            return True, []
        combined = (proc.stdout + proc.stderr).splitlines()
        interesting = [l for l in combined
                       if l.startswith("!") or ".tex:" in l or "Error" in l]
        return False, (interesting or combined)[-15:]


# ---------------------------------------------------------------------------
# The tree: <root>/<N>semester/<course>/<YYYY-MM-DD>-<slug>/
#
# No configuration, no marker files: a directory named like "1semester" is the
# hinge. Everything above it is the root, everything below is a course and its
# entries. So the root can be called anything, and moving the tree changes
# nothing.
# ---------------------------------------------------------------------------
SEMESTER_RE = re.compile(r"^\d+semester$")
ENTRY_RE = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})-(?P<slug>.+)$")

LEVELS = ("root", "semester", "course", "entry", "outside")


@dataclass
class Location:
    """Which level of the tree the current directory sits at."""
    level: str                    # one of LEVELS
    cwd: Path
    root: Path | None = None
    semester: str | None = None
    course: str | None = None
    entry: str | None = None

    @property
    def semester_dir(self):
        return self.root / self.semester if self.semester else None

    @property
    def course_dir(self):
        sem = self.semester_dir
        return sem / self.course if sem and self.course else None

    def describe(self):
        """Where you are, as a path fragment: '1semester/math'."""
        parts = [p for p in (self.semester, self.course, self.entry) if p]
        return "/".join(parts)


def locate(start=None):
    """Work out the level from the directory alone.

    Anchored on the nearest "<N>semester" component of the path, so it also
    works from inside an entry's img/ directory.
    """
    cwd = (start or Path.cwd()).resolve()
    parts = cwd.parts

    index = next((i for i in range(len(parts) - 1, -1, -1)
                  if SEMESTER_RE.match(parts[i])), None)
    if index is not None:
        root = Path(*parts[:index])
        below = parts[index + 1:]
        course = below[0] if below else None
        entry = below[1] if len(below) > 1 and ENTRY_RE.match(below[1]) else None
        level = "semester" if not course else ("entry" if entry else "course")
        return Location(level, cwd, root, parts[index], course, entry)

    if semesters_in(cwd):
        return Location("root", cwd, cwd)
    return Location("outside", cwd)


def semesters_in(root):
    """Semester directories directly under root, in numeric order."""
    if not root or not root.is_dir():
        return []
    names = [p.name for p in root.iterdir() if p.is_dir() and SEMESTER_RE.match(p.name)]
    return sorted(names, key=lambda n: int(n.removesuffix("semester")))


def courses_in(semester_dir):
    if not semester_dir or not semester_dir.is_dir():
        return []
    return sorted(p.name for p in semester_dir.iterdir()
                  if p.is_dir() and not p.name.startswith("."))


COURSE_FILE = ".gm"


def course_meta(course_dir):
    """Read the course's .gm file: {"professor": ..., "brightspace": ...}.

    Yours to write and edit by hand -- gm only ever reads it. Any keys are
    allowed and shown as they are, so it can hold whatever a course needs.
    """
    if not course_dir:
        return {}
    path = course_dir / COURSE_FILE
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        warn(f"{path} is not valid JSON ({exc}); ignoring it")
        return {}
    if not isinstance(data, dict):
        warn(f"{path} should hold a JSON object; ignoring it")
        return {}
    return data


def entries_in(course_dir):
    """[(date, slug, path)] oldest first."""
    if not course_dir or not course_dir.is_dir():
        return []
    found = []
    for path in course_dir.iterdir():
        m = ENTRY_RE.match(path.name)
        if path.is_dir() and m:
            found.append((m.group("date"), m.group("slug"), path))
    return sorted(found)


def slugify(text):
    """'Writing hello world in Python!' -> 'writing-hello-world-in-python'.

    Danish letters are transliterated the way Danes write them in ASCII
    (ø -> oe, not o), so directory names stay readable and shell-safe.
    """
    for src, dst in {"æ": "ae", "ø": "oe", "å": "aa", "Æ": "ae", "Ø": "oe",
                     "Å": "aa", "ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss"}.items():
        text = text.replace(src, dst)
    text = unicodedata.normalize("NFKD", text)
    text = "".join(c for c in text if not unicodedata.combining(c))
    text = re.sub(r"[^A-Za-z0-9]+", "-", text).strip("-").lower()
    return re.sub(r"-{2,}", "-", text)


DEPTH = {"root": 0, "semester": 1, "course": 2, "entry": 3}


def wrong_level(loc, need, what):
    """The one error message that teaches the hierarchy."""
    where = {
        "root": f"the root ({loc.cwd})",
        "semester": f"a semester ({loc.describe()})",
        "course": f"a course ({loc.describe()})",
        "entry": f"an entry ({loc.describe()})",
        "outside": f"{loc.cwd}, which is not part of a coursework tree",
    }[loc.level]

    # Point at the way out. When the directory you need is an ancestor, give the
    # exact relative path -- the shell may be deeper than the level itself, e.g.
    # inside an entry's img/, where "cd .." would land one short.
    target = {"root": loc.root, "semester": loc.semester_dir,
              "course": loc.course_dir}.get(need)
    if target and target.is_dir() and loc.cwd.is_relative_to(target):
        hint = f"cd {os.path.relpath(target, loc.cwd)} up to the {need}"
    elif loc.level == "outside":
        hint = f"cd into a {need} inside a coursework tree"
    else:
        examples = {"semester": "cd 1semester", "course": "cd math"}
        hint = f"cd into a {need} first"
        if need in examples:
            hint += f", e.g. {examples[need]}"

    place = "the root" if need == "root" else f"a {need}"
    return Fail(f"{what} belongs in {place}, but you are in {where}. {hint}")


# ---------------------------------------------------------------------------
# Actions: building the tree
# ---------------------------------------------------------------------------
def cmd_create_semester(args, loc):
    """In the root: make <N>semester."""
    if loc.level not in ("root", "outside"):
        raise wrong_level(loc, "root", "a semester")
    # At the top of the notes repository this would create a directory that sits
    # outside every worktree: untracked, unbacked-up, and invisible to git.
    # Semesters belong inside a worktree.
    if loc.level == "outside" and notes_root_above(loc.cwd):
        raise Fail(f"{loc.cwd} is the notes repository, not a coursework tree. "
                   f"A semester created here would sit outside every worktree, "
                   f"where nothing tracks or backs it up.\n"
                   f"   Open a course instead:  class math\n"
                   f"   Or work in the merged tree:  cd main")

    existing = semesters_in(loc.cwd)
    if args.create_semester:
        m = re.search(r"\d+", str(args.create_semester))
        if not m:
            raise Fail(f"'{args.create_semester}' is not a semester number")
        number = int(m.group())
    else:
        # Next one after the highest that exists, or the first.
        number = max((int(s.removesuffix("semester")) for s in existing), default=0) + 1

    target = loc.cwd / f"{number}semester"
    if args.dry_run:
        log(f"would create {target}")
        return 0
    if target.is_dir():
        ok(f"{target} already exists")
    else:
        target.mkdir(parents=True)
        ok(f"created {target}")
        if loc.level == "outside":
            print(f"   {dim(str(loc.cwd))} {dim('is now a coursework root')}")
    print()
    log(f"cd {target.name} && {INVOKED} --create-course math")
    return 0


def cmd_create_course(args, loc):
    """In a semester: make the course directory."""
    if loc.level != "semester":
        raise wrong_level(loc, "semester", "a course")

    name = args.create_course
    if not name:
        if not sys.stdin.isatty():
            raise Fail(f"--create-course needs a name "
                       f"(example: {INVOKED} --create-course math)")
        name = prompt("course name")
        if not name:
            raise Fail("no course name given")

    slug = args.slug or slugify(name)
    if not slug:
        raise Fail(f"'{name}' does not slugify into a directory name")

    target = loc.cwd / slug
    if args.dry_run:
        log(f"would create {target}")
        return 0
    if target.is_dir():
        ok(f"{target} already exists")
    else:
        target.mkdir()
        ok(f"created {target}")
    print()
    log(f'cd {slug} && {INVOKED} --create-lecture "..."')
    return 0


def cmd_create_entry(kind, title, args, loc):
    """In a course: make a dated entry holding main.tex from a goat template.

    Only in a course: an entry is where you write, so from inside one the answer
    is cd .. rather than nesting another entry underneath it.
    """
    if loc.level != "course":
        raise wrong_level(loc, "course", f"a {kind}")
    course_dir = loc.course_dir
    install = installed_goat()

    if not title:
        if not sys.stdin.isatty():
            raise Fail(f"--create-{kind} needs a title (example: "
                       f'{INVOKED} --create-{kind} "Writing hello world in Python")')
        title = prompt(f"{kind} title")
        if not title:
            raise Fail("no title given")

    date = dt.date.today().isoformat()
    slug = args.slug or slugify(title)
    if not slug:
        raise Fail(f"'{title}' does not slugify into a directory name")

    # Never overwrite: an existing entry without a document may be filled in,
    # but a document that is already there is left exactly as it is.
    target = course_dir / f"{date}-{slug}"
    existing_doc = next((target / n for n in MAIN_CANDIDATES
                         if (target / n).is_file()), None)
    if existing_doc is not None:
        raise Fail(f"{existing_doc.name} already exists in {target.name} — "
                   f"nothing written. Delete it first, or use another title")
    if target.exists() and not target.is_dir():
        raise Fail(f"{target} exists and is not a directory")

    name = args.template or DEFAULT_TEMPLATE[kind]
    template = load_template(name)
    lang = setting("LANG", "english").lower()
    if lang not in STRINGS:
        warn(f"GOAT_LANG='{lang}' is not danish or english; using english")
        lang = "english"
    studentid = setting("STUDENT_ID")
    department = setting("DEPARTMENT")
    body = render_template(template, {
        "version": install.version,
        "title": title,
        "course": loc.course,
        "course_title": loc.course.replace("-", " ").replace("_", " "),
        "author": setting("AUTHOR") or "Your Name",
        "date": date,
        "lang": lang,
        "style": setting("STYLE", "au"),
        "semester": loc.semester,
        # Emitted live when the GOAT_* variable is set, commented out when not,
        # so an unfilled field is visible in the document rather than silent.
        "studentid_line": (f"\\setgoatstudentid{{{studentid}}}" if studentid
                           else "% \\setgoatstudentid{}"),
        "department_line": (f"\\setgoatdept{{{department}}}" if department
                           else "% \\setgoatdept{}"),
        **STRINGS[lang],
    })

    main = target / "main.tex"
    if args.dry_run:
        log(f"would create {target}/")
        for rel in ("main.tex", "img/", ".latexmkrc"):
            print(f"   {rel}")
        log(f"template: {name}")
        return 0

    target.mkdir(parents=True, exist_ok=True)
    (target / "img").mkdir(exist_ok=True)
    main.write_text(body, encoding="utf-8")
    latexmkrc = target / ".latexmkrc"
    if not latexmkrc.exists():
        latexmkrc.write_text(LATEXMKRC, encoding="utf-8")

    ok(f"created {target}")
    print(f"   {dim('template')} {name} ({lang})")
    print(f"   {dim('goat')}     {install.version} (pinned in main.tex)")
    print(f"   {dim('build')}    aux files go to {AUX_DIR}/")
    print()
    log(f"cd {target.name} && latexmk -pdf main.tex")
    return 0


def prompt(question, default="", stream=None):
    """Ask a question. `stream` sends it somewhere other than stdout.

    That matters for --quiet: the `class` shell function captures stdout to cd
    into it, so a question printed there would be swallowed by the capture and
    gm would sit waiting for an answer to something you never saw.
    """
    suffix = f" [{default}]" if default else ""
    out = stream or sys.stdout
    try:
        print(f"{C_BLUE}?{C_RESET} {question}{suffix} ", end="", file=out,
              flush=True)
        answer = input().strip()
    except EOFError:
        answer = ""
    return answer or default


# ---------------------------------------------------------------------------
# Actions: looking around
# ---------------------------------------------------------------------------
def cmd_status(args, loc):
    """The bare `gm`: which level you are on, and what is on it."""
    if loc.level == "outside":
        # Standing in the repository itself (~/aarhusuni) rather than in one of
        # its worktrees. There is no coursework tree here and there should not
        # be: the trees live one level down, inside main/ and course/<name>/.
        # Saying "not inside a coursework tree" would be true and useless, and
        # the offer to --create-semester here would be actively wrong.
        if notes_root_above(loc.cwd):
            return cmd_classes(args)
        print(f"{C_BLUE}::{C_RESET} {loc.cwd}")
        warn("not inside a coursework tree (no <N>semester directory here or above)")
        log(f"make this directory a root: {INVOKED} --create-semester 1")
        return 0

    # The absolute path already contains the root and every level below it, so
    # there is nothing to add but the name of the level you are on.
    print(f"{C_BLUE}::{C_RESET} {loc.cwd}  {dim('(' + loc.level + ')')}")
    print()

    if loc.level == "root":
        names = semesters_in(loc.cwd)
        width = max((len(n) for n in names), default=0)
        for name in names:
            count = len(courses_in(loc.cwd / name))
            print(f"   {name.ljust(width)}  {count:>3} "
                  f"{'course' if count == 1 else 'courses':<7}")
        print()
        log(f"cd into a semester, or: {INVOKED} --create-semester "
            f"{max((int(n.removesuffix('semester')) for n in names), default=0) + 1}")
        return 0

    if loc.level == "semester":
        names = courses_in(loc.cwd)
        if not names:
            warn(f"no courses in {loc.semester} yet")
            log(f"{INVOKED} --create-course math")
            return 0
        width = max(len(n) for n in names)
        for name in names:
            found = entries_in(loc.cwd / name)
            line = (f"   {name.ljust(width)}  {len(found):>3} "
                    f"{'entry' if len(found) == 1 else 'entries':<7}")
            if found:
                date, slug, _p = found[-1]
                line += f"   {dim('latest')} {date} {slug.replace('-', ' ')}"
            print(line)
        print()
        log(f"cd into a course, or: {INVOKED} --create-course math")
        return 0

    # An entry is where you write: report the document, not ways to make more.
    if loc.level == "entry":
        entry_dir = loc.course_dir / loc.entry
        doc = next((entry_dir / n for n in MAIN_CANDIDATES
                    if (entry_dir / n).is_file()), None)
        if doc is None:
            warn("no document in this entry")
            log(f"cd .. and re-run --create-lecture with the same title to "
                f"put a main.tex here")
            return 0
        print(f"   {dim('document:')} {doc.name}  {describe_pin(doc)}")
        print()
        log(f"latexmk -pdf {doc.name}")
        log(f"{INVOKED} {doc.name} --check-upgrade")
        log(f"cd ..   {dim('to see the rest of ' + loc.course)}")
        return 0

    # course: whatever the .gm file says about it, then the entries.
    meta = course_meta(loc.course_dir)
    if meta:
        width = max(len(k) for k in meta)
        for key, value in meta.items():
            shown = value if isinstance(value, str) else json.dumps(value)
            print(f"   {dim(key.ljust(width))}  {shown}")
        print()

    found = entries_in(loc.course_dir)
    if not found:
        warn(f"no entries in {loc.course} yet")
        log(f'{INVOKED} --create-lecture "..."')
        return 0
    for date, slug, path in found:
        doc = next((n for n in MAIN_CANDIDATES if (path / n).is_file()), None)
        note = "" if doc else dim("  (no document)")
        print(f"   {date}  {slug.replace('-', ' ')}{note}")
    print()
    log(f'{INVOKED} --create-lecture "..."   '
        f'{dim("new entry with main.tex from a goat template")}')
    return 0


def describe_pin(doc):
    """'goat 0.1 (magic comment, main.tex:1)' for the status view."""
    try:
        scan = scan_document(doc)
    except Fail:
        return dim("(unreadable)")
    pin = scan.pin()
    if pin and pin.version:
        return f"goat {pin.version} {dim('(' + pin.describe() + ')')}"
    if pin:
        return f"goat release dated {pin.raw} {dim('(' + pin.describe() + ')')}"
    if not scan.uses_goat:
        return dim("(does not use goat)")
    try:
        return f"goat {installed_goat().version} {dim('(not pinned)')}"
    except Fail:
        return dim("(not pinned)")


