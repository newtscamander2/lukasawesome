LECTURE_TEMPLATE = """\
% !goat version = {version}
\\documentclass[12pt]{{article}}
\\usepackage[style={style}, lang={lang}]{{goat}}

\\setgoattitle{{{title}}}
\\setgoatsubtitle{{{course_title}}}
\\setgoatauthor{{{author}}}
\\setgoatcourse{{{course_title}}}
\\setgoatdate{{{date}}}
\\goatheader

\\begin{{document}}

\\section{{{s_overview}}}

\\section{{{s_notes}}}

% \\begin{{gnote}}
%   {t_note}
% \\end{{gnote}}

% \\begin{{gcode}}{{python}}
% print("hello world")
% \\end{{gcode}}

% \\gimage[caption={{{t_caption}}}, label=sketch]{{img/sketch.png}}
% goat-img -c "{t_caption}"   copies the newest phone photo into img/

\\section{{{s_exercises}}}

\\end{{document}}
"""

HOMEWORK_TEMPLATE = """\
% !goat version = {version}
\\documentclass[12pt]{{article}}
\\usepackage[style={style}, lang={lang}, frontpage]{{goat}}

\\setgoattitle{{{title}}}
\\setgoatauthor{{{author}}}
\\setgoatcourse{{{course_title}}}
\\setgoatdate{{{date}}}
{studentid_line}

\\begin{{document}}

\\begin{{qs}}{{{t_problem} 1}}
  {t_restate}
\\end{{qs}}

{t_answer}

% \\begin{{gcode}}{{python}}
% def solve(xs):
%     ...
% \\end{{gcode}}

\\begin{{qs}}{{{t_problem} 2}}
  {t_restate}
\\end{{qs}}

{t_answer}

\\end{{document}}
"""

REPORT_TEMPLATE = """\
% !goat version = {version}
\\documentclass[12pt]{{article}}
\\usepackage[style={style}, lang={lang}, frontpage]{{goat}}

\\setgoattitle{{{title}}}
\\setgoatauthor{{{author}}}
\\setgoatcourse{{{course_title}}}
\\setgoatdate{{{date}}}
{studentid_line}
{department_line}
% \\setgoatsupervisor{{}}
\\setgoatabstract{{{t_abstract}}}

\\goatheader

\\begin{{document}}

\\tableofcontents
\\newpage

\\section{{{s_intro}}}
{t_intro}

\\section{{{s_method}}}
{t_method}

% \\begin{{gcode}}{{python}}
% def solve(xs):
%     ...
% \\end{{gcode}}

\\section{{{s_results}}}
{t_results}

% \\gtable[caption={{{t_table}}}, label=timings]{{lrr}}{{
%   \\toprule {t_input} & A & B \\\\ \\midrule
%   1000 & 12 & 3 \\\\ \\bottomrule
% }}

\\section{{{s_discussion}}}
{t_discussion}

\\section{{{s_conclusion}}}
{t_conclusion}

\\printbibliography[heading=bibnumbered]

\\end{{document}}
"""

