# --- Secrets: NEVER commit these ---
*.kdbx
*.kdbx.lock
*.key
*.pem
secrets/

# --- Per-machine state (deliberately not shared between machines) ---
install.conf
# Marker file; rc.lua enables the looping video wallpaper when it exists.
# Left machine-local so the laptop can skip it.
awesome/.config/awesome/video_wallpaper

# --- Generated by systemctl --user enable ---
# The stow packages are symlinked into ~/.config, so 'enable' writes its
# .wants symlinks back inside the repo. They contain absolute /home paths
# and would break on any other machine; let 'enable' recreate them instead.
**/systemd/user/*.target.wants/

# --- Logs ---
*.log

# --- LaTeX build artifacts ---
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.toc
*.bbl
*.blg

# --- Editor / OS cruft ---
*.swp
*~
.DS_Store
