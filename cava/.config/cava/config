# Cava config for the AwesomeWM dashboard-tile visualizer (rc.lua consumes raw
# ascii frames on stdout). Standalone terminal use still works: `cava -p
# /dev/null` for defaults, or just run `cava` and ignore the raw numbers.
[general]
bars = 44
framerate = 30
autosens = 1

[smoothing]
# cava's own smoothing; rc.lua additionally applies exponential smoothing on
# the values it receives, because raw frames read as "shaky" otherwise.
monstercat = 1.5
noise_reduction = 45

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
