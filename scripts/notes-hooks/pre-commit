#!/usr/bin/env bash
# pre-commit for the notes repository (~/aarhusuni).
#
# Installed into the repo's .githooks/ by `make notes`, and reached via
# core.hooksPath. It is tracked *in* the notes repo, so every machine that
# clones gets the same guardrails without installing anything.
#
# It enforces the one rule that makes merge conflicts impossible: work done in a
# course's working directory may only touch that course. Two courses therefore
# never edit the same file, and every merge into main is decided by git alone.
#
# The rule follows the WORKING DIRECTORY, not the branch: <notes>/course/math is
# the maths worktree whatever branch happens to be checked out in it. That way
# you can branch and experiment as freely as you like -- try something on
# feature/whatever, switch back, keep both -- without stepping outside maths by
# accident. Keying on the branch name would have meant the guardrail silently
# switched off the moment you left course/math, which is exactly when a stray
# commit is most likely.
#
# Outside a course worktree (main/, or a repo laid out some other way) it falls
# back to the branch name, and if that says nothing either, nothing is restricted.
#
# Deliberately conservative: it only ever refuses a commit. It never edits the
# index, never unstages anything, never rewrites a file. Escape hatch, for the
# rare commit that genuinely spans courses:
#
#     GOAT_ANY=1 git commit -m "..."
#
set -uo pipefail

RED=''; YELLOW=''; DIM=''; RESET=''
if [ -t 2 ]; then
    RED=$'\033[1;31m'; YELLOW=$'\033[1;33m'; DIM=$'\033[2m'; RESET=$'\033[0m'
fi
refuse() { printf '%s  x %s%s\n' "$RED" "$RESET" "$*" >&2; }
detail() { printf '     %s\n' "$*" >&2; }

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo '')"

# Nothing staged (e.g. `git commit --amend --only`) — nothing to check.
if git diff --cached --quiet 2>/dev/null; then
    exit 0
fi

fail=0

# --- 1. No stray gitlinks ----------------------------------------------------
# A nested repository committed by accident becomes a mode 160000 entry: a bare
# 40-character hash that no clone can resolve, because the parent has no idea
# where the thing came from. That is the trap in "a git repo inside a git repo",
# and this is the wire across it. Real submodules (listed in .gitmodules) are
# still allowed, so the check never gets in the way of a deliberate one.
while IFS=$'\t' read -r meta path; do
    [ -n "${path:-}" ] || continue
    # ":<srcmode> <dstmode> <srcsha> <dstsha> <status>" — the destination mode
    # is the one being committed.
    read -r _srcmode dstmode _rest <<<"${meta#:}"
    [ "$dstmode" = "160000" ] || continue
    if [ -f .gitmodules ] && git config --file .gitmodules --get-regexp path \
            | awk '{print $2}' | grep -qxF "$path"; then
        continue
    fi
    refuse "$path is a repository of its own, and would be committed as an"
    detail "unresolvable pointer (gitlink) that no clone can restore."
    detail ""
    detail "Take it out of this commit:"
    detail "  git rm --cached ${path}"
    detail "Then register it properly, so it can be cloned back:"
    detail "  cd ${path} && gm --nest --project <gitlab-project-name>"
    fail=1
done < <(git diff --cached --raw --no-renames)

# --- 2. Work in a course's directory stays in that course --------------------
# Which course this worktree belongs to. <notes>/course/<name> is the layout gm
# creates, so the directory answers it directly; the branch is only consulted
# when the directory does not say.
toplevel="$(git rev-parse --show-toplevel 2>/dev/null || echo '')"
course=""
if [ -n "$toplevel" ] && [ "$(basename "$(dirname "$toplevel")")" = "course" ]; then
    course="$(basename "$toplevel")"
    scope="the directory $(basename "$(dirname "$toplevel")")/${course}"
else
    case "$branch" in
        course/*) course="${branch#course/}"; scope="the branch ${branch}" ;;
    esac
fi

case "$course" in
    ?*)
        # Allowed: <N>semester/<course>/anything. Nothing else, on purpose —
        # not even the repository's own README, which belongs to main.
        offenders=()
        while IFS= read -r path; do
            [ -n "$path" ] || continue
            [[ "$path" =~ ^[0-9]+semester/${course}/ ]] && continue
            offenders+=("$path")
        done < <(git diff --cached --name-only)

        if [ "${#offenders[@]}" -gt 0 ]; then
            refuse "work in ${scope} may only change files under"
            detail "<N>semester/${course}/ — that is what keeps merges conflict-free."
            detail ""
            detail "Outside it:"
            for path in "${offenders[@]:0:10}"; do detail "  ${path}"; done
            [ "${#offenders[@]}" -gt 10 ] && \
                detail "  ... and $(( ${#offenders[@]} - 10 )) more"
            detail ""
            detail "Unstage them:  git restore --staged ${offenders[0]}"
            detail "Or, if this really is a cross-course commit:"
            detail "  GOAT_ANY=1 git commit ..."
            fail=1
        fi
        ;;
esac

# --- 3. Nothing enormous -----------------------------------------------------
# Notes are text. A stray lecture recording or dataset here is permanent: it
# stays in the history of every future clone even after you delete the file.
limit_mb="$(git config --int goat.maxfilemb 2>/dev/null || echo 20)"
limit=$(( limit_mb * 1024 * 1024 ))
while IFS= read -r path; do
    [ -n "$path" ] || continue
    # The staged blob, not the file on disk: those can differ, and it is the
    # staged one that would enter the history.
    blob=$(git rev-parse --quiet --verify ":${path}" 2>/dev/null) || continue
    size=$(git cat-file -s "$blob" 2>/dev/null || echo 0)
    [ "$size" -le "$limit" ] && continue
    refuse "$path is $(( size / 1024 / 1024 )) MB — over the ${limit_mb} MB limit."
    detail "History is forever: a big file stays in every clone even after you"
    detail "delete it. Keep it out of the repo, or raise the limit deliberately:"
    detail "  git config goat.maxfilemb 100"
    fail=1
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$fail" -ne 0 ]; then
    if [ "${GOAT_ANY:-0}" = "1" ]; then
        printf '%s  ! %sGOAT_ANY=1 — committing anyway.%s\n' \
            "$YELLOW" "$RESET" "$DIM$RESET" >&2
        exit 0
    fi
    printf '%s     nothing was changed; your work is still here.%s\n' \
        "$DIM" "$RESET" >&2
    exit 1
fi
exit 0
